{
  "name": "@qbtc/vault",
  "version": "1.1.0",
  "private": false,
  "description": "Password-protected BIP-39 seed storage with locking, lifecycle events and encrypted application data. Storage and application-specific parameters are supplied by the consumer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbitcoin-project/qbitcoin-js.git",
    "directory": "packages/vault"
  },
  "homepage": "https://github.com/qbitcoin-project/qbitcoin-js/tree/main/packages/vault",
  "bugs": {
    "url": "https://github.com/qbitcoin-project/qbitcoin-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@qbtc/crypto": "^1.1.0"
  },
  "devDependencies": {
    "@qbtc/crypto": "1.1.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.0.5"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/*.fixtures.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
