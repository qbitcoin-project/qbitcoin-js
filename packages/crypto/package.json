{
  "name": "@qbtc/crypto",
  "version": "1.1.0",
  "private": false,
  "description": "Cryptographic core for wallets on the QBitcoin protocol — hashing, encoding, addresses, HD derivation (secp256k1 + Falcon-512), signing. Ships no chain constants: each chain injects its parameters via a ChainProfile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbitcoin-project/qbitcoin-js.git",
    "directory": "packages/crypto"
  },
  "homepage": "https://github.com/qbitcoin-project/qbitcoin-js/tree/main/packages/crypto",
  "bugs": {
    "url": "https://github.com/qbitcoin-project/qbitcoin-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "@scure/base": "1.2.4",
    "@scure/bip32": "1.6.2",
    "@scure/bip39": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.0.5",
    "@vitest/coverage-v8": "3.0.5"
  },
  "files": [
    "dist",
    "wasm",
    "src",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/*.vectors.ts",
    "!src/**/*.fixtures.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
