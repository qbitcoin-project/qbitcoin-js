{
  "name": "@qbtc/chain",
  "version": "1.1.0",
  "private": false,
  "description": "Esplora-compatible chain client for wallets on the QBitcoin protocol — balance, UTXOs, fee estimates, broadcast, node failover. Ships no endpoint URLs: the consumer supplies its node list.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbitcoin-project/qbitcoin-js.git",
    "directory": "packages/chain"
  },
  "homepage": "https://github.com/qbitcoin-project/qbitcoin-js/tree/main/packages/chain",
  "bugs": {
    "url": "https://github.com/qbitcoin-project/qbitcoin-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.0.5",
    "@vitest/coverage-v8": "3.0.5"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!src/**/*.test.ts",
    "!src/fixtures"
  ],
  "publishConfig": {
    "access": "public"
  }
}
